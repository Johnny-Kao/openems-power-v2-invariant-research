+	private static int redistributeResidual(List<Entry> free, int[] assigned, int remaining, boolean isActive,
+			boolean allowSignChange) {
+		var headrooms = new long[free.size()];
+		long totalHeadroom = 0;
+		for (int i = 0; i < free.size(); i++) {
+			var e = free.get(i);
+			var min = isActive ? e.ownActiveMin() : e.ownReactiveMin();
+			var max = isActive ? e.ownActiveMax() : e.ownReactiveMax();
+			var bound = remaining > 0 //
+					? (!isActive || allowSignChange || assigned[i] >= 0 ? max : Math.min(0, max)) //
+					: (!isActive || allowSignChange || assigned[i] <= 0 ? min : Math.max(0, min));
+			headrooms[i] = Math.max(0L, remaining > 0 //
+					? (long) bound - assigned[i] //
+					: (long) assigned[i] - bound);
+			totalHeadroom += headrooms[i];
+		}
+		for (int i = 0; i < free.size() && remaining != 0 && totalHeadroom > 0; i++) {
+			var adjustment = (long) remaining * headrooms[i] / totalHeadroom;
+			adjustment = Math.max(-headrooms[i], Math.min(headrooms[i], adjustment));
+			assigned[i] += (int) adjustment;
+			remaining -= (int) adjustment;
+			totalHeadroom -= headrooms[i];
+		}
+		return remaining;
+	}
